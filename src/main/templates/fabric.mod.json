{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "name": "${mod_name}",
  "version": "${mod_version}",
  "description": "${mod_description}",
  "environment": "client",
  "contact": {
    "issues": "${mod_issue_tracker}",
    "sources": "${mod_repo}"
  },
  "icon": "assets/${mod_id}/icon.png",
  "entrypoints": {
    "client": [
      "me.andreasmelone.pinkfont.PinkFontMod"
    ],
    "modmenu": [
      "me.andreasmelone.pinkfont.config.ModMenuAdapter"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "java": ">=${java_version}",
    "yet_another_config_lib_v3": ">=${yacl_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.com/invite/3vfnvBFRKv"
      }
    }
  }
}